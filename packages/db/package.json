{
  "name": "@echo/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "schema:generate": "pnpm exec kysely-codegen --env-file .env --out-file src/schema.d.ts",
    "migration:create": "node src/migration-create.ts",
    "migration:down": "node src/migrate-down.ts"
  },
  "dependencies": {
    "@echo/auth": "workspace:*",
    "better-auth": "^1.6.24",
    "dotenv": "^16.6.1",
    "kysely": "^0.27.6",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@echo/config": "workspace:*",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.20.0",
    "kysely-codegen": "^0.16.8",
    "typescript": "^5.9.3"
  }
}
