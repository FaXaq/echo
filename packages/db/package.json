{
  "name": "@echo/db",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "schema:generate": "pnpm exec kysely-codegen --env-file .env --out-file src/schema.d.ts",
    "migration:create": "node src/migration-create.ts",
    "migration:down": "node src/migrate-down.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@echo/auth": "workspace:*",
    "better-auth": "^1.4.18",
    "dotenv": "^16.5.0",
    "kysely": "^0.27.4",
    "pg": "^8.13.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@echo/config": "workspace:*",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.11.10",
    "kysely-codegen": "^0.16.8",
    "typescript": "^5.7.0"
  }
}
