    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth/cli": "catalog:",
    "@echo/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "kysely-codegen": "^0.16.8",
    "typescript": "catalog:"
  }
}
