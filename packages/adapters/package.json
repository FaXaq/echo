{
  "name": "@echo/adapters",
  "private": true,
  "type": "module",
  "exports": {
    "./s3-storage": {
      "types": "./src/s3-storage/index.ts",
      "default": "./src/s3-storage/index.ts"
    },
    "./mailer": {
      "types": "./src/mailer/index.ts",
      "default": "./src/mailer/index.ts"
    },
    "./geocoding": {
      "types": "./src/geocoding/index.ts",
      "default": "./src/geocoding/index.ts"
    }
  },
  "scripts": {
