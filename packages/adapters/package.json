  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "@aws-sdk/s3-request-presigner": "^3.1093.0",
    "@echo/errors": "workspace:*",
    "nodemailer": "^8.0.11"
  },
  "devDependencies": {
    "@echo/config": "workspace:*",
    "@types/nodemailer": "^7.0.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
