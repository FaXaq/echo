{
  "name": "@echo/app",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts",
      "schema": "./src/schema/index.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "default": "./src/errors.ts"
    },
    "./ports": {
      "types": "./src/ports/index.ts",
      "default": "./src/ports/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@echo/auth": "workspace:*",
    "@echo/domain": "workspace:*",
    "zod": "4"
  },
  "devDependencies": {
    "@echo/config": "workspace:*",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
