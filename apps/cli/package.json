{
  "name": "@echo/cli",
  "private": true,
  "license": "AGPL-3.0-only",
  "bin": {
    "echo": "./dist/main.js"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "execute": "tsx src/main.ts",
    "build": "build-node src/main.ts dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node dist/main.js db migrate",
    "user:create": "node dist/main.js user create",
    "user:list": "node dist/main.js user list",
    "user:get": "node dist/main.js user get",
    "user:update": "node dist/main.js user update",
    "user:delete": "node dist/main.js user delete",
    "user:ban": "node dist/main.js user ban",
    "user:unban": "node dist/main.js user unban",
    "user:set-role": "node dist/main.js user set-role",
    "user:create-first-user": "node dist/main.js user create-first-user",
    "session:list": "node dist/main.js session list",
    "session:revoke": "node dist/main.js session revoke",
    "rgpd:export": "node dist/main.js rgpd export",
    "rgpd:anonymize": "node dist/main.js rgpd anonymize",
    "rgpd:report": "node dist/main.js rgpd report"
  },
  "dependencies": {
    "@echo/auth": "workspace:*",
    "@echo/db": "workspace:*",
    "@echo/modules": "workspace:*",
    "better-auth": "catalog:",
    "commander": "^13.1.0",
    "dotenv": "catalog:",
    "kysely": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@echo/config": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
