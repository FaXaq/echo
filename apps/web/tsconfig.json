{
  "extends": "@echo/config/tsconfig.react.json",
  "compilerOptions": {
    "rootDir": "src",
    "paths": {
      "@/ui": ["./src/components/ui"],
      "@/ui/*": ["./src/components/ui/*"],
      "@/*": ["./src/*"]
    },
    "outDir": "dist",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src"]
}
