import { authClient } from '@/lib/auth'
import { Outlet } from '@tanstack/react-router';
import { createFileRoute, redirect } from '@tanstack/react-router'

export const Route = createFileRoute('/_auth-guard/organizations/$organizationSlug')({
  beforeLoad: async ({ params }) => {
    const { data: activeOrganization } = await authClient.organization.getFullOrganization({ query: { membersLimit: 0 } });
    if (activeOrganization?.slug !== params.organizationSlug) {
      throw redirect({ to: "/" })
    }
  },
  component: RouteComponent,
})

function RouteComponent() {
  return <Outlet />
}
